@model string
@* Persona 4 — Valeria Calvo Chaves. Página para errores de negocio (403, 404, 409). *@
@{
    var codigo = ViewBag.CodigoEstado ?? 400;
    string titulo;
    switch ((int)codigo)
    {
        case 403: titulo = "Acceso denegado"; break;
        case 404: titulo = "Recurso no encontrado"; break;
        case 409: titulo = "Operación no permitida"; break;
        default: titulo = "Solicitud no válida"; break;
    }
    ViewBag.Title = titulo;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <p class="display-6 fw-bold text-danger mb-1">@codigo</p>
                <h1 class="h4">@titulo</h1>
                <p class="text-muted">@Model</p>
                <a class="btn btn-outline-success" href="javascript:history.back()">Volver</a>
            </div>
        </div>
    </div>
</div>
