
@model IEnumerable<EcoRutas.Data.Entities.Tour>

@{
    ViewBag.Title = "Administrar tours";
}

<h2>Administración de tours</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<p>
    @Html.ActionLink(
            "Registrar nuevo tour",
            "Create",
            null,
            new { @class = "btn btn-primary" })
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Dificultad</th>
            <th>Duración</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var tour in Model)
            {
                <tr>
                    <td>
                        @if (tour.Imagenes != null && tour.Imagenes.Any())
                        {
                            var imagen = tour.Imagenes.OrderBy(i => i.Orden).FirstOrDefault();

                            <img src="@Url.Action("Imagen", "Tours", new { id = imagen.ImagenTourId })"
                                 alt="Imagen de @tour.Nombre"
                                 style="width:100px; height:70px; object-fit:cover; border-radius:6px;" />
                        }
                        else
                        {
                            <span class="text-muted">Sin imagen</span>
                        }
                    </td>

                    <td>@tour.CodigoTour</td>
                    <td>@tour.Nombre</td>
                    <td>@(tour.Categoria != null ? tour.Categoria.Nombre : "Sin categoría")</td>
                    <td>@(tour.Dificultad != null ? tour.Dificultad.Nombre : "Sin dificultad")</td>
                    <td>@tour.DuracionMinutos minutos</td>

                    <td>
                        @if (tour.EstadoId == 1)
                        {
                            <span class="label label-success">Activo</span>
                        }
                        else
                        {
                            <span class="label label-default">Inactivo</span>
                        }
                    </td>

                    <td>
                        @Html.ActionLink(
                                 "Detalles",
                                 "Details",
                                 new { id = tour.TourId },
                                 new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink(
                                 "Editar",
                                 "Edit",
                                 new { id = tour.TourId },
                                 new { @class = "btn btn-warning btn-sm" })

                        @using (Html.BeginForm(
                            "CambiarEstado",
                            "Tours",
                            FormMethod.Post,
                            new { style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", tour.TourId)

                            if (tour.EstadoId == 1)
                            {
                                <input type="hidden" name="activar" value="false" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('¿Desea inactivar este tour?');">
                                    Inactivar
                                </button>
                            }
                            else
                            {
                                <input type="hidden" name="activar" value="true" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">
                                    Activar
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">
                    No hay tours registrados.
                </td>
            </tr>
        }
    </tbody>
</table>
