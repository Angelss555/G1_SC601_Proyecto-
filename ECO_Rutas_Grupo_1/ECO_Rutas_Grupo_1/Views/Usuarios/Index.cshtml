@model List<EcoRutas.Service.Models.UsuarioListadoModel>
@* Persona 4 — Valeria Calvo Chaves. Listado administrativo de usuarios. *@
@{
    ViewBag.Title = "Usuarios";
    var filtro = (EcoRutas.Service.Models.UsuarioFiltroModel)ViewBag.Filtro;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">Gestión de usuarios</h1>
        <p class="text-muted mb-0">Cree usuarios, asigne roles y active o inactive cuentas.</p>
    </div>
    @Html.ActionLink("Nuevo usuario", "Crear", null, new { @class = "btn btn-success" })
</div>

@using (Html.BeginForm("Index", "Usuarios", FormMethod.Get, new { @class = "card card-body border-0 shadow-sm mb-3" }))
{
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="Texto" class="form-label">Buscar</label>
            <input type="search" id="Texto" name="Texto" value="@filtro.Texto" class="form-control" placeholder="Nombre, correo o código" />
        </div>
        <div class="col-md-3">
            <label for="Rol" class="form-label">Rol</label>
            @Html.DropDownList("Rol", (SelectList)ViewBag.Roles, "Todos", new { @class = "form-select" })
        </div>
        <div class="col-md-2">
            <label for="EstadoId" class="form-label">Estado</label>
            <select id="EstadoId" name="EstadoId" class="form-select">
                <option value="">Todos</option>
                <option value="1" @(filtro.EstadoId == 1 ? "selected" : "")>Activo</option>
                <option value="2" @(filtro.EstadoId == 2 ? "selected" : "")>Inactivo</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-outline-success">Filtrar</button>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Correo</th>
                    <th scope="col">Rol</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Última conexión</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay usuarios que coincidan con el filtro.</td>
                    </tr>
                }
                @foreach (var u in Model)
                {
                    <tr>
                        <td><code class="small">@u.CodigoUsuario.Substring(0, Math.Min(8, u.CodigoUsuario.Length))</code></td>
                        <td>@u.NombreCompleto</td>
                        <td>@u.Email</td>
                        <td><span class="badge rounded-pill text-bg-info">@(string.IsNullOrEmpty(u.Rol) ? "Sin rol" : u.Rol)</span></td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge rounded-pill text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="small">@(u.UltimaConexion.HasValue ? u.UltimaConexion.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca")</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Editar", "Editar", new { id = u.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                            @if (u.Activo)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#modalConfirmacion"
                                        data-accion="@Url.Action("CambiarEstado", new { id = u.Id, activar = false })"
                                        data-titulo="Inactivar usuario"
                                        data-mensaje="¿Desea inactivar a @u.NombreCompleto? No podrá iniciar sesión hasta que se active de nuevo."
                                        data-boton="Inactivar"
                                        data-clase-boton="btn-danger">
                                    Inactivar
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-success"
                                        data-bs-toggle="modal" data-bs-target="#modalConfirmacion"
                                        data-accion="@Url.Action("CambiarEstado", new { id = u.Id, activar = true })"
                                        data-titulo="Activar usuario"
                                        data-mensaje="¿Desea activar a @u.NombreCompleto?"
                                        data-boton="Activar"
                                        data-clase-boton="btn-success">
                                    Activar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@Html.Partial("_ModalConfirmacionPartial")

@section scripts {
    <script src="~/Scripts/eco-confirmacion.js"></script>
}