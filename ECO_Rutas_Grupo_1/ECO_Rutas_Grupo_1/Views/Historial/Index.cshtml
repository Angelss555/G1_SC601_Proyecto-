@model List<EcoRutas.Service.Models.HistorialReservaModel>
@* Persona 4 — Valeria Calvo Chaves. Historial de reservas del asociado. *@
@{
    ViewBag.Title = "Mis reservas";
    var cultura = new System.Globalization.CultureInfo("es-CR");
}

<div class="mb-3">
    <h1 class="h3 mb-0">Mis reservas</h1>
    <p class="text-muted mb-0">
        Puede cancelar una salida confirmada hasta 48 horas antes de su fecha y hora.
        Al cancelar se liberan los cupos y se anulan los pases de esa salida.
    </p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no tiene reservas registradas.</div>
}

@foreach (var reserva in Model)
{
    <section class="card border-0 shadow-sm mb-4" aria-labelledby="reserva-@reserva.ReservaId">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h6 mb-0" id="reserva-@reserva.ReservaId">
                Reserva #@reserva.ReservaId
                <small class="text-muted fw-normal">· @reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")</small>
            </h2>
            <span class="fw-semibold">Total vigente: @reserva.TotalVigente.ToString("C", cultura)</span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Tour / salida</th>
                        <th scope="col" class="text-center">Pasajeros</th>
                        <th scope="col" class="text-end">Precio p/p</th>
                        <th scope="col" class="text-end">Subtotal</th>
                        <th scope="col">Estado</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in reserva.Detalles)
                    {
                        <tr class="@(d.EstaCancelado ? "text-muted" : "")">
                            <td>
                                <div class="fw-semibold">@d.NombreTour</div>
                                <div class="small text-muted">
                                    @d.FechaHoraSalida.ToString("dddd dd/MM/yyyy HH:mm", cultura) · @d.PuntoEncuentro
                                </div>
                            </td>
                            <td class="text-center">@d.CantidadPasajeros</td>
                            <td class="text-end">@d.PrecioPorPersona.ToString("C", cultura)</td>
                            <td class="text-end @(d.EstaCancelado ? "text-decoration-line-through" : "")">@d.Subtotal.ToString("C", cultura)</td>
                            <td>
                                @Html.Partial("_EstadoDetalleBadge", d.EstadoId)
                                @if (d.FechaCancelacion.HasValue)
                                {
                                    <div class="small text-muted">el @d.FechaCancelacion.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#pases-@d.DetalleReservaId"
                                        aria-expanded="false" aria-controls="pases-@d.DetalleReservaId">
                                    Pases (@d.Pases.Count)
                                </button>
                                @if (d.PuedeCancelar)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#modalConfirmacion"
                                            data-accion="@Url.Action("Cancelar", "Historial", new { id = d.DetalleReservaId })"
                                            data-titulo="Cancelar reserva"
                                            data-mensaje="¿Desea cancelar la salida de «@d.NombreTour» del @d.FechaHoraSalida.ToString("dd/MM/yyyy HH:mm")? Se cancelarán los @d.CantidadPasajeros pase(s) de esta salida y la acción no se puede deshacer."
                                            data-boton="Sí, cancelar"
                                            data-clase-boton="btn-danger">
                                        Cancelar
                                    </button>
                                }
                                else if (d.EstadoId == 1)
                                {
                                    <span class="d-inline-block" tabindex="0" title="@d.MotivoNoCancelable">
                                        <button type="button" class="btn btn-sm btn-outline-danger" disabled>Cancelar</button>
                                    </span>
                                }
                            </td>
                        </tr>
                        <tr class="collapse" id="pases-@d.DetalleReservaId">
                            <td colspan="6" class="bg-light">
                                @if (d.EstadoId == 1 && !d.PuedeCancelar)
                                {
                                    <p class="small text-muted mb-2">@d.MotivoNoCancelable</p>
                                }
                                <table class="table table-sm mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Código de pase</th>
                                            <th scope="col">Pasajero</th>
                                            <th scope="col">Identificación</th>
                                            <th scope="col">Estado del pase</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in d.Pases)
                                        {
                                            <tr>
                                                <td><code>@p.CodigoPase</code></td>
                                                <td>@p.NombrePasajero</td>
                                                <td>@p.Identificacion</td>
                                                <td>
                                                    @if (p.Anulado)
                                                    {
                                                        <span class="badge text-bg-secondary">Anulado</span>
                                                    }
                                                    else if (p.Asistio)
                                                    {
                                                        <span class="badge text-bg-success">Asistió</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-primary">Vigente</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@Html.Partial("_ModalConfirmacionPartial")

@section scripts {
    <script src="~/Scripts/eco-confirmacion.js"></script>
}