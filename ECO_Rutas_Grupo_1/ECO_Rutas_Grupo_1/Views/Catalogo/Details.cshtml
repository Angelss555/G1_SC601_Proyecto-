
@model EcoRutas.Data.Entities.Tour

@{
    ViewBag.Title = "Detalles del tour";
}

<h2>@Model.Nombre</h2>

<p>@Model.Descripcion</p>

<hr />

<h3>Información del tour</h3>

<dl class="dl-horizontal">
    <dt>Código</dt>
    <dd>@Model.CodigoTour</dd>

    <dt>Categoría</dt>
    <dd>@(Model.Categoria != null ? Model.Categoria.Nombre : "Sin categoría")</dd>

    <dt>Dificultad</dt>
    <dd>@(Model.Dificultad != null ? Model.Dificultad.Nombre : "Sin dificultad")</dd>

    <dt>Duración</dt>
    <dd>@Model.DuracionMinutos minutos</dd>

    <dt>Punto de encuentro</dt>
    <dd>@Model.PuntoEncuentro</dd>
</dl>

<hr />

<h3>Galería de imágenes</h3>

@if (Model.Imagenes != null && Model.Imagenes.Any())
{
    <div class="row">
        @foreach (var imagen in Model.Imagenes.OrderBy(i => i.Orden))
        {
            <div class="col-md-4" style="margin-bottom:20px;">
                <img src="@Url.Action("Imagen", "Catalogo", new { id = imagen.ImagenTourId })"
                     alt="@Model.Nombre"
                     style="width:100%; height:220px; object-fit:cover;" />
            </div>
        }
    </div>
}
else
{
    <p>No hay imágenes disponibles.</p>
}

<hr />

<h3>Próximas salidas disponibles</h3>

<div id="mensajeCarrito"></div>
@Html.AntiForgeryToken()

@if (Model.Salidas != null && Model.Salidas.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Precio por persona</th>
                    <th>Cupos disponibles</th>
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Asociado"))
                    {
                        <th>Reservar</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var salida in Model.Salidas.OrderBy(s => s.FechaHora))
                {
                    <tr>
                        <td>@salida.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@salida.PrecioPorPersona.ToString("C")</td>
                        <td>@salida.CuposDisponibles</td>

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Asociado"))
                        {
                            <td>
                                <div class="form-inline">
                                    <select class="form-control cantidad-pasajeros"
                                            style="width:75px;"
                                            data-salida-id="@salida.SalidaId">
                                        @for (int i = 1; i <= Math.Min(6, salida.CuposDisponibles); i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>

                                    <button type="button"
                                            class="btn btn-primary btn-agregar-carrito"
                                            data-salida-id="@salida.SalidaId">
                                        Agregar al carrito
                                    </button>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        Actualmente no hay salidas disponibles para este tour.
    </div>
}

<p>
    @Html.ActionLink(
            "Volver al catálogo",
            "Index",
            "Catalogo",
            null,
            new { @class = "btn btn-default" }
        )
</p>

@section scripts {
    <script>
        document.querySelectorAll(".btn-agregar-carrito").forEach(function (boton) {
            boton.addEventListener("click", async function () {
                var salidaId = this.dataset.salidaId;
                var selector = document.querySelector(
                    '.cantidad-pasajeros[data-salida-id="' + salidaId + '"]'
                );

                var cantidad = selector.value;
                var mensaje = document.getElementById("mensajeCarrito");
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                this.disabled = true;

                try {
                    var respuesta = await fetch('@Url.Action("Agregar", "Carrito")', {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        body: new URLSearchParams({
                            salidaId: salidaId,
                            cantidadPasajeros: cantidad,
                            __RequestVerificationToken: token
                        })
                    });

                    if (!respuesta.ok) {
                        var error = await respuesta.text();
                        throw new Error(error || "No se pudo agregar la salida.");
                    }

                    await respuesta.json();

                    mensaje.className = "alert alert-success";
                    mensaje.textContent =
                        "La salida se agregó correctamente al carrito.";
                }
                catch (error) {
                    mensaje.className = "alert alert-danger";
                    mensaje.textContent = error.message;
                }
                finally {
                    this.disabled = false;
                }
            });
        });
    </script>
}
